{
    "name": "lukenjohnson/php-idempotent-api-sample",
    "description": "Production-oriented PHP example for scoped API keys, transactional writes, and idempotent retries.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Example\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
